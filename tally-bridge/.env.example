# TallyPrime running on the same Windows PC
TALLY_URL=http://127.0.0.1:9000

# Bridge port
BRIDGE_PORT=8787

# Set a long random secret before exposing the bridge through a tunnel
BRIDGE_TOKEN=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Optional: restrict browser origin when using a direct browser-to-bridge setup
ALLOW_ORIGIN=https://portal.7xei.onrender.com
